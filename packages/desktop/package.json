{
  "name": "@sample-seeker/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.mjs",
    "start": "electron .",
    "typecheck": "pnpm --filter @sample-seeker/core build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron ../../node_modules/vitest/vitest.mjs",
    "lint": "biome lint",
    "check": "biome check --write"
  },
  "dependencies": {
    "@sample-seeker/core": "workspace:*",
    "node-osc": "^11.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.0.0",
    "typescript": "^5.6.0"
  }
}
