{
  "name": "sample-seeker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm --filter @sample-seeker/core build && pnpm --filter @sample-seeker/desktop build",
    "start": "pnpm build && pnpm --filter @sample-seeker/desktop start",
    "sample-seeker": "node packages/core/dist/cli.js",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "lefthook install",
    "test-samples": "node scripts/test-samples/build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^22.20.5",
    "electron": "^45.0.0",
    "lefthook": "^2.2.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
